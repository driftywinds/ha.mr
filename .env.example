# The domain used in generated compressed links, e.g.:
#   HAMR_DOMAIN=example.com
#
# Set this and run `node build.js` to bake the domain into the built site
# (dist/). If it is left unset, the site uses whatever domain it is served
# from at runtime, so no configuration is needed for most self-hosted setups.
HAMR_DOMAIN=example.com
